# Copy this file to .env and fill in your own Supabase development project's
# values. Never commit real credentials — .env is git-ignored (see FR-009).
# See README.md "Configurar backend de desarrollo" for how to get these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opcional: DSN de Sentry (Project Settings → Client Keys). Vacío = desactivado.
VITE_SENTRY_DSN=
